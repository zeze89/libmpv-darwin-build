+        bool is_sparse = vo_c->is_sparse;
+        double tolerance = mpctx->demuxer->ts_resets_possible &&
+                           !is_sparse ? 5 : 1e4;
+        if (duration >= tolerance) {
+            double nominal = demux_duration;
+            if (nominal <= 0 && mpctx->num_past_frames > 1 &&
+                mpctx->past_frames[1].duration > 0 &&
+                mpctx->past_frames[1].duration < tolerance)
+                nominal = mpctx->past_frames[1].duration;
+            MP_WARN(mpctx, "Timestamp discontinuity: %f -> %f, using frame "
+                       "duration %f\n", pts0, pts1, nominal);
+            duration = nominal;
